<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>VCE Flour Alternatives</name>
  <author>pengin0503</author>
  <packageId>pengin0503.vce.flouralternatives</packageId>
  <modVersion>0.3.0</modVersion>
  <url>https://github.com/pengin0503/rimworld-VCE-Flour-Patch</url>
  <supportedVersions>
    <li>1.6</li>
    <li>1.7</li>
  </supportedVersions>
  <description>Adds rice flour and cornmeal made from vanilla rice and corn at fueled and electric stoves or a crafting spot. Both powders can substitute for wheat flour in Vanilla Cooking Expanded's baked meals. No new meals are introduced. Requires Harmony, Vanilla Expanded Framework and Vanilla Cooking Expanded.</description>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
    </li>
    <li>
      <packageId>OskarPotocki.VanillaFactionsExpanded.Core</packageId>
      <displayName>Vanilla Expanded Framework</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/workshop/filedetails/?id=2023507013</steamWorkshopUrl>
      <downloadUrl>https://github.com/Vanilla-Expanded/VanillaExpandedFramework</downloadUrl>
    </li>
    <li>
      <packageId>VanillaExpanded.VCookE</packageId>
      <displayName>Vanilla Cooking Expanded</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/workshop/filedetails/?id=2134308519</steamWorkshopUrl>
      <downloadUrl>https://github.com/Vanilla-Expanded/VanillaCookingExpanded</downloadUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <li>OskarPotocki.VanillaFactionsExpanded.Core</li>
    <li>VanillaExpanded.VCookE</li>
  </loadAfter>
</ModMetaData>
