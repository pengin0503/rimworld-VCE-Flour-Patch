<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>PFA_MillRice</defName>
    <label>mill rice into rice flour x2</label>
    <description>Grind 20 rice into 20 rice flour, which can replace wheat flour in VCE baked meals.</description>
    <jobString>Grinding rice into rice flour.</jobString>
    <workAmount>600</workAmount>
    <workSkill>Cooking</workSkill>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <recipeUsers>
      <li>FueledStove</li>
      <li>ElectricStove</li>
    </recipeUsers>
    <fixedIngredientFilter>
      <thingDefs><li>RawRice</li></thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs><li>RawRice</li></thingDefs>
    </defaultIngredientFilter>
    <ingredients>
      <li>
        <filter><thingDefs><li>RawRice</li></thingDefs></filter>
        <count>20</count>
      </li>
    </ingredients>
    <products><PFA_RiceFlour>20</PFA_RiceFlour></products>
  </RecipeDef>

